/**
 * @field context {Context}
 * @field id {Id}
 * @field definition {map}
 *      @param pointSets {array} : an array of point sets. Each item in the array is a map `{"isArc" : boolean, "plane" : plane, "arcStart" : vector, "arcMid" : vector, "arcEnd" : vector, "point" : vector}`
 *      @param closed {boolean} : is the polyline curve closed?
 */
export function createLinesFromPointSets(context is Context, id is Id, definition is map)
{
    var loopStart = 0;
    var loopEnd = size(definition.pointSets);

    if (!definition.closed)
    {
        loopEnd -= 1;
    }

    definition.pointSets = append(definition.pointSets, definition.pointSets[0]);

    for (var i = loopStart; i < loopEnd; i += 1)
    {
        const startSet = definition.pointSets[i];
        const endSet = definition.pointSets[i + 1];
        const sketch = newSketchOnPlane(context, id + "lineSketch" + i, { "sketchPlane" : startSet.plane });

        const startPoint = startSet.isArc ? startSet.arcEnd : startSet.point;
        const endPoint = endSet.isArc ? endSet.arcStart : endSet.point;

        skLineSegment(sketch, "line1", {
                    "start" : worldToPlane(startSet.plane, startPoint),
                    "end" : worldToPlane(startSet.plane, endPoint)
                });

        skSolve(sketch);
    }
}

/**
 * @field context {Context}
 * @field id {Id}
 * @field definition {map}
 *      @param pointSets {array} : an array of point sets. Each item in the array is a map `{"isArc" : boolean, "plane" : plane, "arcStart" : vector, "arcMid" : vector, "arcEnd" : vector, "point" : vector}`
 *      @param closed {boolean} : is the polyline curve closed?
 */
export function createArcsFromPointSets(context is Context, id is Id, definition)
{
    for (var i = 0; i < size(definition.pointSets); i += 1)
    {
        const pointSet = definition.pointSets[i];

        if (pointSet.isArc && !tolerantEquals(pointSet.arcStart, pointSet.arcEnd))
        {
            const sketch = newSketchOnPlane(context, id + "arcSketch" + i, { "sketchPlane" : pointSet.plane });

            skArc(sketch, "arc", {
                        "start" : worldToPlane(pointSet.plane, pointSet.arcStart),
                        "mid" : worldToPlane(pointSet.plane, pointSet.arcMid),
                        "end" : worldToPlane(pointSet.plane, pointSet.arcEnd)
                    });
            skSolve(sketch);
        }
    }
}


/**
 * @param context {Context}:
 * @param definition {{
 *      @field points {query} : a list of points to create a polyline through
 *      @field closed {boolean} : `false` leaves the end points open. `true` connects the final point to the start
 *      @field byRadius {boolean}
 *      @field radius
 *      @field width
 * }}
 */
export function getArcPointSets(context is Context, definition) returns array
{
    var points = definition.points;
    // const lastIsDuplicate = tolerantEquals(points[size(points) - 1], points[size(points) - 2]);
    // if (lastIsDuplicate)
    // {
    //     points = resize(points, size(points) - 1);
    // }

    // add the last point to the beginning to get a triangle for the arc math.
    points = concatenateArrays([[points[size(points) - 1]], points, [points[0]]]);
    // doing the same here so it matches,
    var vertexSettings = concatenateArrays([[definition.vertices[size(definition.vertices) - 1]], definition.vertices, [definition.vertices[0]]]);

    const loopStart = 1;
    const loopEnd = size(points) - 1;

    var pointSets = [];
    for (var i = loopStart; i < loopEnd; i += 1)
    {
        var pointSet = {};
        const setting = vertexSettings[i];

        // figuring whether to add radius based on individual override or the global setting
        const overrideFillet = setting.filletCorner;
        const measurement = overrideFillet ? setting.cornerBlendControlType : definition.filletAllBlendControlType;
        const radius = overrideFillet ? setting.cornerRadius : definition.allRadius;
        const width = overrideFillet ? setting.cornerWidth : definition.allWidth;

        // used downstream to know where to draw arcs and where to continue the line all the way to the sharp.
        const hasFillet = (setting.filletCorner || definition.filletAll);
        const hasZeroRadius = setting.filletCorner && (tolerantEquals(radius, 0 * meter) && measurement == BlendControlType.RADIUS) || (tolerantEquals(width, 0 * meter) && measurement == BlendControlType.WIDTH);
        const isNotEndPoint = (i != loopStart && i != loopEnd - 1);

        pointSet.isArc = (isNotEndPoint || definition.closed) && hasFillet && !hasZeroRadius;

        if (!tolerantEquals(points[i], points[i + 1]))
        {
            const lineDir1 = normalize(points[i - 1] - points[i]); // from current point toward prev point
            const lineDir2 = normalize(points[i + 1] - points[i]); // from current point toward next point

            var angle;
            var bisectedDir;
            if (tolerantEquals(lineDir1, lineDir2)) // if it forms a straight line back on itself i.e. 0° angle
            {
                angle = 0 * degree;
                bisectedDir = lineDir1;
                pointSet.isArc = false;
            }
            else if (tolerantEquals(lineDir1, -lineDir2)) // if it forms a straight line i.e. 180° angle
            {
                angle = 180 * degree;
                bisectedDir = plane(points[i], lineDir1).x;
                pointSet.isArc = false;
            }
            else // all other cases
            {
                angle = angleBetween(lineDir1, lineDir2);
                bisectedDir = normalize(lineDir1 + lineDir2); // from current point toward arc center
            }

            const setback = getSetbackForFillet({
                        "angle" : angle,
                        "byRadius" : measurement == BlendControlType.RADIUS,
                        "radius" : radius,
                        "width" : width,
                    });
                    
            if (!setback.isColinear)
            {
                pointSet.arcStart = points[i] + lineDir1 * setback.setback;
                pointSet.arcMid = points[i] + bisectedDir * setback.apexToMidpoint;
                pointSet.arcEnd = points[i] + lineDir2 * setback.setback;
                pointSet.plane = plane(points[i], cross(lineDir1, lineDir2), lineDir1);
                pointSet.radius = radius;
                pointSet.plane = plane(points[i], cross(lineDir1, lineDir2), lineDir1);
            }
            else
            {
                pointSet.plane = plane(points[i], perpendicularVector(lineDir1), lineDir1);
                pointSet.radius = 0*meter;
            }
        }
        pointSet.point = points[i];

        pointSets = append(pointSets, pointSet);
    }

    return pointSets;
}


/**
 * Gets the distance info needed for a 3-point arc between two lines.
 * @param definition {{
 *      @field angle {ValueWithUnits}: The angle between two lines to fillet.
 *      @field byRadius {boolean}: If `true`, drive the size of the arc by a radius. If `false`, drive the size of the arc by a chord width. Default is `false`.
 *      @field radius {ValueWithUnits}: The radius of the fillet @requiredIf {`byRadius` is `true`}
 *      @field width {ValueWithUnits}: The chord width of the fillet @requiredIf {`byRadius` is `false`}
 * }}
 * @returns {{
 *      @field setback {ValueWithUnits}: The distance along each line from the apex to the.
 *      @field radius {ValueWithUnits}: The radius of the arc.
 *      @field apexToCenter {ValueWithUnits}: The distance from the intersection of the lines to the arc center.
 *      @field apexToMidpoint {ValueWithUnits}: The distance from the intersection of the lines to the arc midpoint.
 * }}
 */
export function getSetbackForFillet(definition) returns map
{
    var result = {};

    result.isColinear = tolerantEquals(definition.angle, 180 * degree) || tolerantEquals(definition.angle, 0 * degree);

    if (!result.isColinear)
    {
        const halfAngle = definition.angle / 2;

        if (definition.byRadius) // setback by radius
        {
            result.setback = definition.radius / tan(halfAngle);
            result.radius = definition.radius;
        }
        else // setback by width
        {
            const halfWidth = definition.width / 2;
            result.setback = halfWidth / sin(halfAngle);
            result.radius = tan(halfAngle) * result.setback;
        }

        result.apexToCenter = result.setback / cos(halfAngle);
        result.apexToMidpoint = result.apexToCenter - result.radius;
    }

    return result;
}

