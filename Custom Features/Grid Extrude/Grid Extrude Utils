export function getGridCenter(context is Context, definition is map) returns Vector
{
    var result;

    const plane = evPlane(context, { "face" : definition.entities->qNthElement(0) });

    if (!isQueryEmpty(context, definition.gridCenter))
        result = project(plane, evVertexPoint(context, { "vertex" : definition.gridCenter }));

    else
        result = plane.origin;

    return result;
}


export type GridInfo typecheck canBeGridInfo;

export predicate canBeGridInfo(value)
{
    value is map;

    value.startPoint is Vector;
    value.endPoint is Vector;

    value.xStartCount is number;
    value.xEndCount is number;

    value.yStartCount is number;
    value.yEndCount is number;
}

/**
 * @return gridInfo {map} {{
 *      @field xStartCount {number} : The number of instances that fit between gridOrigin and xStart. Can be negative if the minCorner is in the negative x direction.
 *      @field xEndCount {number} : The number of instances that fit between gridOrigin and xEnd. Can be negative if the maxCorner is in the negative x direction.
 *      @field xCount {number} : The number of x instances that fit inside of the box.
 *      @field xStart {valueWithUnits} : The x component of the pattern start vector.
 *      @field xEnd {valueWithUnits} : The x component of the pattern end vector
 *      @field yStartCount {number} : The number of instances that fit between gridOrigin and yStart. Can be negative if the minCorner is in the negative y direction.
 *      @field yEndCount {number} : The number of instances that fit between gridOrigin and yEnd. Can be negative if the maxCorner is in the negative y direction.
 *      @field yCount {number} : The number of y instances that fit inside of the box.
 *      @field yStart {valueWithUnits} : The y component of the pattern start vector.
 *      @field yEnd {valueWithUnits} : The y component of the pattern end vector
 *      @field startPoint {vector} : the first point in the pattern (which should fall outside of the bounding box near the minCorner)
 *      @field endPoint {vector} : the last point in the pattern (which should fall outside of the bounding box near the maxCorner)
 * }}
 */
export function gridInfo(definition is map, boundingBox is Box3d) returns GridInfo
{
    var result = {};

    const xMin = boundingBox.minCorner[0]; // x component of the min box corner
    const xMax = boundingBox.maxCorner[0]; // x component of the max box corner
    const yMin = boundingBox.minCorner[1]; // y component of the min box corner
    const yMax = boundingBox.maxCorner[1]; // y component of the max box corner

    result.xStartCount = floor(xMin / definition.xSpacing); // the number of instances that fit between gridOrigin and xStart. Can be negative if the minCorner is in the negative x direction.
    result.xEndCount = ceil(xMax / definition.xSpacing) + 1; // the number of instances that fit between gridOrigin and xEnd. Can be negative if the maxCorner is in the negative x direction.
    // result.xCount = result.xEndCount - result.xStartCount; // the number of x instances that fit inside of the box
    const xStart = result.xStartCount * definition.xSpacing; // the x component of the pattern start vector
    const xEnd = result.xEndCount * definition.xSpacing; // the x component of the pattern end vector

    result.yStartCount = floor(yMin / definition.ySpacing); // the number of instances that fit between gridOrigin and yStart. Can be negative if the minCorner is in the negative y direction.
    result.yEndCount = ceil(yMax / definition.ySpacing) + 1; // the number of instances that fit between gridOrigin and yEnd. Can be negative if the mayCorner is in the negative y direction.
    // result.yCount = result.yEndCount - result.yStartCount; // the number of y instances that fit inside of the box
    const yStart = result.yStartCount * definition.ySpacing; // the y component of the pattern start vector
    const yEnd = result.yEndCount * definition.ySpacing; // the y component of the pattern end vector

    result.startPoint = vector(xStart, yStart, 0 * meter);
    result.endPoint = vector(xEnd, yEnd, 0 * meter);

    return result as GridInfo;
}

/**
 * @return {array}: An array of points forming the grid.
 */
export function getGridPointsInBox(definition is map, boundingBox is Box3d) returns map
{
    const gridInfo = gridInfo(definition, boundingBox);

    var points = [];
    var instanceNames = [];
    var transforms = [];

    const origin = definition.transformToGridCoord * WORLD_ORIGIN;

    for (var i = gridInfo.yStartCount; i < gridInfo.yEndCount; i += 1) // Controls Y direction (row index)
    {
        for (var j = gridInfo.xStartCount; j < gridInfo.xEndCount; j += 1) // Controls X direction (column index)
        {
            if (!(i == 0 && j == 0)) // removes the origin instance, which we don't need to duplicate.
            {
                var shiftRow = i % 2 != 0; //shift odd rows over for hexagonal tiling.
                const rowShift = shiftRow && definition.isHexagonal ? definition.xSpacing / 2 : 0 * meter;
                const x = definition.xSpacing * j + rowShift;
                const y = definition.ySpacing * i;
                const newPoint = vector(x, y, 0 * meter);
                const newTransformedPoint = definition.transformToGridCoord * newPoint;
                points = append(points, newTransformedPoint);
                transforms = append(transforms, transform(newTransformedPoint - origin));
                instanceNames = append(instanceNames, "x" ~ j ~ "y" ~ i);
            }
        }
        // shiftRow = !shiftRow; // making the next row the opposite shift of this one
    }

    return { "points" : points, "instanceNames" : instanceNames, "transforms" : transforms };
}


/**
 * Takes a map containing an array of points, and sets of 1:1 corresponding arrays (i.e. transforms for the points and instanceNames for the points), and returns the map without duplicate points and their corresponding info.
 */
export function deduplicatePointsAndCorrespondingInfo(arrays is map) returns map
{
    // The fancy way
    // return foldArray(clusterPoints(points, TOLERANCE.zeroLength * meter), { "points" : [], "instanceNames" : [] }, function(result, cluster)
    //     {
    //         return result->insertIntoMapOfArrays("points", points[cluster[0]])->insertIntoMapOfArrays("instanceNames", instanceNames[cluster[0]]);
    //     });
    var result = {};

    var newPoints = [];
    var newInstanceNames = [];
    const pointClusters = clusterPoints(arrays.points, TOLERANCE.zeroLength * meter);
    for (var key, value in arrays)
    {
        result[key] = [];
        for (var cluster in pointClusters)
        {
            result[key] = append(result[key], value[cluster[0]]);
        }
    }

    return result;
}

export function processGridDirection(context is Context, gridDirection is Query, sketchPlane is Plane) returns Vector
{
    const direction = extractDirection(context, gridDirection);
    const directionLine = line(sketchPlane.origin, direction);
    const positiveLine = line(sketchPlane.origin, sketchPlane.normal);
    const negativeLine = line(sketchPlane.origin, -sketchPlane.normal);
    if (tolerantEquals(directionLine, positiveLine) || tolerantEquals(directionLine, negativeLine))
    {
        throw regenError("The grid direction must not match the extrusion direction.");
    }
    else
    {
        return project(sketchPlane, directionLine).direction; // returns the projected direction so the user doesn't have to choose a direction that is exactly perpindicular to the extrusion direction.
    }
}


