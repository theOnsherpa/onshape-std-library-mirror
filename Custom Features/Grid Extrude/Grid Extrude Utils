export predicate mainViewExtrudePredicate(definition is map)
{
    annotation { "Name" : "Faces and sketch regions to extrude",
                "Filter" : ((AllowFlattenedGeometry.YES && SketchObject.YES && EntityType.FACE) ||
                        (GeometryType.PLANE && AllowFlattenedGeometry.NO && EntityType.FACE)) && ConstructionObject.NO
            }
    definition.entities is Query;

    annotation { "Name" : "End type" }
    definition.endBound is BoundingType;

    annotation { "Name" : "Opposite direction", "UIHint" : UIHint.OPPOSITE_DIRECTION }
    definition.oppositeDirection is boolean;

    extrudeBoundParametersPredicate(definition);

    // extrudeDirectionPredicate(definition);

    // extrudeOffsetPredicate(definition);

    if (definition.endBound == BoundingType.BLIND || definition.endBound == BoundingType.THROUGH_ALL)
    {
        annotation { "Name" : "Symmetric" }
        definition.symmetric is boolean;
    }

    annotation { "Name" : "Draft", "UIHint" : ["DISPLAY_SHORT", "FIRST_IN_ROW"] }
    definition.hasDraft is boolean;

    if (definition.hasDraft == true)
    {
        annotation { "Name" : "Draft angle", "UIHint" : UIHint.DISPLAY_SHORT }
        isAngle(definition.draftAngle, ANGLE_STRICT_90_BOUNDS);

        annotation { "Name" : "Opposite direction", "Column Name" : "Draft opposite direction", "UIHint" : UIHint.OPPOSITE_DIRECTION_CIRCULAR }
        definition.draftPullDirection is boolean;
    }


    if (!isSymmetricExtrude(definition))
    {
        annotation { "Name" : "Second end position",
                    "UIHint" : UIHint.FIRST_IN_ROW }
        definition.hasSecondDirection is boolean;

        annotation { "Group Name" : "Second end position", "Driving Parameter" : "hasSecondDirection", "Collapsed By Default" : false }
        {
            if (definition.hasSecondDirection)
            {
                annotation { "Name" : "End type", "Column Name" : "Second end type" }
                definition.secondDirectionBound is BoundingType;

                annotation { "Name" : "Opposite direction", "Column Name" : "Second opposite direction",
                            "UIHint" : UIHint.OPPOSITE_DIRECTION, "Default" : true }
                definition.secondDirectionOppositeDirection is boolean;

                extrudeSecondDirectionBoundParametersPredicate(definition);

                if ((definition.secondDirectionOppositeDirection && !definition.oppositeDirection) ||
                    (!definition.secondDirectionOppositeDirection && definition.oppositeDirection))
                {
                    annotation { "Name" : "Draft", "Column Name" : "Second draft", "UIHint" : ["DISPLAY_SHORT", "FIRST_IN_ROW"] }
                    definition.hasSecondDirectionDraft is boolean;

                    if (definition.hasSecondDirectionDraft)
                    {
                        annotation { "Name" : "Draft angle", "Column Name" : "Second draft angle", "UIHint" : UIHint.DISPLAY_SHORT }
                        isAngle(definition.secondDirectionDraftAngle, ANGLE_STRICT_90_BOUNDS);

                        annotation { "Name" : "Opposite direction", "Column Name" : "Second draft opposite direction", "UIHint" : UIHint.OPPOSITE_DIRECTION_CIRCULAR }
                        definition.secondDirectionDraftPullDirection is boolean;
                    }
                }
            }
        }
    }

}


export predicate extrudeGridPredicate(definition is map)
{
    annotation { "Group Name" : "Grid", "Collapsed By Default" : false }
    {
        annotation { "Name" : "Grid type", "UIHint" : [UIHint.SHOW_LABEL, UIHint.REMEMBER_PREVIOUS_VALUE] }
        definition.GridShapeType is GridShapeType;

        annotation { "Name" : "Grid center (optional)",
                    "Filter" : QueryFilterCompound.ALLOWS_VERTEX, "MaxNumberOfPicks" : 1,
                    "Description" : "Without a center selected, the grid centers on the first face selected, but may be positioned unpredictably. When a point or mate connector is selected, that point is projected onto the plane of the first selection to become the grid center."
                }
        definition.gridCenter is Query;

        annotation { "Name" : "Grid direction (optional)",
                    "Filter" : QueryFilterCompound.ALLOWS_DIRECTION, "MaxNumberOfPicks" : 1,
                    "Description" : "Without a direction selected, the grid may orient unpredictably."
                }
        definition.gridDirection is Query;

        annotation { "Name" : "Grid angle",
                    "Description" : "Rotate the grid relative to the grid direction."
                }
        isAngle(definition.gridAngle, { (degree) : [-360, 0, 360] } as AngleBoundSpec);

        annotation { "Name" : "Flip grid angle", "UIHint" : UIHint.OPPOSITE_DIRECTION_CIRCULAR }
        definition.flipGridAngle is boolean;

        annotation { "Name" : "Cell width",
                // "UIHint" : UIHint.REMEMBER_PREVIOUS_VALUE
                }
        isLength(definition.width, { (millimeter) : [1e-6, 25, 1e5] } as LengthBoundSpec);

        if (definition.GridShapeType == GridShapeType.Rectangle)
        {
            annotation { "Name" : "Cell length",
                    // "UIHint" : UIHint.REMEMBER_PREVIOUS_VALUE
                    }
            isLength(definition.length, { (millimeter) : [1e-6, 40, 1e5] } as LengthBoundSpec);
        }

        annotation { "Name" : "Cell gap",
                    // "UIHint" : UIHint.REMEMBER_PREVIOUS_VALUE,
                    "Description" : "Extra space between the grid cells which forms ribs in normal mode, or gaps when `invert grid` is selected.",
                }
        isLength(definition.ribThickness, { (millimeter) : [0, 3, 1e5] } as LengthBoundSpec);

        if (definition.GridShapeType != GridShapeType.CircleHex && definition.GridShapeType != GridShapeType.CircleSq)
        {
            annotation { "Name" : "Corner radius" }
            isLength(definition.cornerRadius, { (millimeter) : [0, 0, 1e6] } as LengthBoundSpec);
        }

        annotation { "Name" : "Add boundary", "Default" : false }
        definition.addBoundary is boolean;

        
        if (definition.addBoundary)
        {
            // annotation { "Name" : "Alignment", "UIHint" : UIHint.REMEMBER_PREVIOUS_VALUE }
            // definition.boundaryAlignmentType is BoundaryAlignmentType;

            annotation { "Name" : "Mid plane" }
            definition.boundaryMidPlane is boolean;

            if (!definition.boundaryMidPlane)
            {
                annotation { "Name" : "Thickness 1" }
                isLength(definition.boundaryThickness1, { (millimeter) : [0, 1.5, 1e5] } as LengthBoundSpec);

                annotation { "Name" : "Flip boundary", "UIHint" : UIHint.OPPOSITE_DIRECTION }
                definition.flipBoundary is boolean;

                annotation { "Name" : "Thickness 2" }
                isLength(definition.boundaryThickness2, { (millimeter) : [0, 1.5, 1e5] } as LengthBoundSpec);

            }
            else
            {
                annotation { "Name" : "Thickness" }
                isLength(definition.boundaryMidThickness, { (millimeter) : [0, 3, 1e5] } as LengthBoundSpec);
            }
        }

        annotation { "Name" : "Invert grid", "Default" : false }
        definition.invertGrid is boolean;

        annotation { "Name" : "Preview grid points", "Default" : false, "Description" : "Preview the grid points to troubleshoot long regeneration times. If there are a lot of points outside of the selected faces, consider splitting up the faces into a few faces, since each face generates its own grid. For example, an L shaped face is inefficient, so it could be split into two rectangles for better performance. Turn off the preview when finished for the best performance." }
        definition.previewPoints is boolean;
    }
}

