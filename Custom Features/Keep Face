FeatureScript 2615;
import(path : "onshape/std/common.fs", version : "2615.0");
import(path : "9f4c9835d8018ff7dbdb5683/7784890493c12aa714be2e4b/c60f4a6e12f07acee647a2a1", version : "d952debcdf1679368ee7bcdd");
icon::import(path : "4177204fd2b51aa91c0ab2be", version : "db5ededfdc29d71500b0f8b2");

annotation { "Feature Type Name" : "Keep face",
        "Icon" : icon::BLOB_DATA
    }
export const keepFace = defineFeature(function(context is Context, id is Id, definition is map)
    precondition
    {
        annotation { "Name" : "Faces to keep",
                    "UIHint" : UIHint.SHOW_CREATE_SELECTION,
                    "Filter" : (EntityType.FACE) && ConstructionObject.NO && SketchObject.NO && ModifiableEntityOnly.YES && AllowMeshGeometry.YES }
        definition.keepFaces is Query;

    }
    {
        definition.leaveOpen = true;
        definition.capVoid = false;
        definition.includeFillet = false;
        const ownerBodies = qOwnerBody(definition.keepFaces);

        const allBodyFaces = qOwnedByBody(ownerBodies, EntityType.FACE);

        definition.deleteFaces = qSubtraction(allBodyFaces, definition.keepFaces);

        opDeleteFace(context, id, definition);
    });
