const STELLATE_LENGTH_BOUNDS = 
{
      (millimeter) : [0,100,1000],
  } as LengthBoundSpec;
  
const STELLATE_ANGLE_BOUNDS = 
{
      (degree) : [0.01,60,90],
  } as AngleBoundSpec;
  

annotation { "Feature Type Name" : "Stellate", "Icon" : icon::BLOB_DATA }
export const stellate = defineFeature(function(context is Context, id is Id, definition is map)
    precondition
    {
        annotation { "Name" : "Faces", "Filter" : EntityType.FACE,}
        definition.faceSelection is Query;
        
        annotation { "Name" : "Length" }
        isLength(definition.length, STELLATE_LENGTH_BOUNDS);
        
        annotation { "Name" : "Angle" }
        isAngle(definition.angle, STELLATE_ANGLE_BOUNDS);
        
        annotation { "Name" : "All Faces" }
        definition.allFaces is boolean;
        
        annotation { "Name" : "Inward" }
        definition.inward is boolean;
        
        
    }
    {
        
    var Body is Query = qOwnerBody(definition.faceSelection);
    var allFaces is Query = qOwnedByBody(Body, EntityType.FACE);
    var faceArray is array = evaluateQuery(context, definition.faceSelection);
    
    if (definition.allFaces)
    {
        faceArray = evaluateQuery(context, allFaces);
    }
    else
    {
        faceArray = evaluateQuery(context, definition.faceSelection);
    }
    
    for (var i = 0; i < size(faceArray); i += 1)
    {
        var face is Query = faceArray[i];    
        var faceNormal is Vector = evPlane(context, {
        "face" : face
        }).normal;
        
        if (definition.inward)
        {
            faceNormal = -faceNormal;
        }
        
        opExtrude(context, id + i + "extrude1", {
                "entities" : face,
                "direction" : faceNormal,
                "endBound" : BoundingType.BLIND,
                "endDepth" : definition.length
        });
        
        var startCap is Query = qCapEntity(id + i + "extrude1", true);
        var endCap is Query = qCapEntity(id + i + "extrude1", false);
        var allCaps is Query = qUnion([startCap,endCap]);
        var sideFaces is Query = qSubtraction(qCreatedBy(id + i + "extrude1", EntityType.FACE), allCaps);
        
        opDraft(context, id + i + "draft1", {
                "neutralPlane" : face,
                "pullVec" : faceNormal,
                "draftFaces" : sideFaces,
                "angle" : definition.angle,
                "draftType" : DraftType.NEUTRAL_PLANE
        });
        
        var mainBody is Query = qOwnerBody(face);
        var newBody is  Query = qCreatedBy(id + i + "extrude1", EntityType.BODY);
        
        
        if (definition.inward)
        {
            opBoolean(context, id + i + "boolean1", {
                    "tools" : newBody,
                    "targets" : mainBody,
                    "operationType" : BooleanOperationType.SUBTRACTION
            });
        }
        else
        {
           opBoolean(context, id + i + "boolean1", {
                "tools" : qUnion([mainBody, newBody]),
                "operationType" : BooleanOperationType.UNION
        }); 
        }
        
        
    }

    
    
    
    
    
    
    
    
    
//////////////END////////////////// 
});
