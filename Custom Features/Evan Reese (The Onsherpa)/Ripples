export function isOdd(num is number) returns boolean
{
    return num % 2 != 0;
}

export function getRippleFacePlanes(context is Context, id is Id, definition is map) returns map
{
    var result = {};
    
    const facePeriodicity = evFacePeriodicity(context, {"face" : definition.face});

    const isUPeriodic = facePeriodicity[0];
    const uStep = 1 / (definition.uCount - 1);
    const uCount = isUPeriodic ? definition.uCount - 1 : definition.uCount;

    const isVPeriodic = facePeriodicity[1];
    const vStep = 1 / (definition.vCount - 1);
    const vCount = isVPeriodic ? definition.vCount - 1 : definition.vCount;

    // getting all of the planes ahead of time with evFaceTangentPlanes() is faster than using evFaceTangentPlane() in the nested loops
    var parameters = [];
    for (var u = 0; u < definition.uCount; u += 1)
    {
        for (var v = 0; v < definition.vCount; v += 1)
        {
            parameters = append(parameters, vector(uStep * u, vStep * v));
        }
    }

    result.facePlanes = evFaceTangentPlanes(context, {
                "face" : definition.face,
                "parameters" : parameters
            });


    if (!isQueryEmpty(context, definition.proxyFace))
    {
        result.proxyFacePlanes = evFaceTangentPlanes(context, {
                    "face" : definition.proxyFace,
                    "parameters" : parameters
                });
    }

    return result;
}

export function getRippleDistances(context is Context, id is Id, definition is map, rippleFacePlanes is array) returns array
{
    // const approxFace = evApproximateBSplineSurface(context, { "face" : definition.face }).bSplineSurface; // used to tell which directions should be periodic
    const facePeriodicity = evFacePeriodicity(context, {"face" : definition.face});
    const isUPeriodic = facePeriodicity[0];
    const isVPeriodic = facePeriodicity[1];
    
    var rippleDistances = [];

    for (var u = 0; u < definition.uCount; u += 1)
    {
        var vPoints = [];
        var vDistances = [];
        for (var v = 0; v < definition.vCount; v += 1)
        {
            var samplePlane = rippleFacePlanes[(definition.vCount * u) + v];


            var pointDist = 0 * meter;
            // used to freeze the edges so the new surface lines up with the old one-ish.
            var isBorder = ((u == 0 || u == definition.uCount - 1) && !isUPeriodic) || ((v == 0 || v == definition.vCount - 1) && !isVPeriodic);

            if (!isBorder)
            {
                // could use later maybe to freeze more border points for a shot at maintaining something closer to tangency with surrounding geometry
                // var is2ndBorder = ((u == 1 || u == definition.uCount - 2) && !isUPeriodic) || ((v == 1 || v == definition.vCount - 2) && !isVPeriodic);

                var dampingFactor = 1;
                for (var mods in definition.mods)
                {

                    const objects = mods.modObjects;
                    const rangeStart = mods.dampingRangeStart;
                    const rangeEnd = mods.dampingRange + mods.dampingRangeStart;
                    const nearFactor = mods.dampingNearFactor;
                    const farFactor = mods.dampingFarFactor;
                    const distance = clamp(evDistance(context, { "side0" : objects, "side1" : samplePlane.origin }).distance, rangeStart, rangeEnd);
                    const rangeFactor = remap(distance, rangeStart, rangeEnd, nearFactor, farFactor);
                    const rangeFactorToWave = easeLinearRange(rangeFactor);

                    dampingFactor *= rangeFactorToWave;
                }

                if (definition.creationType == TextureCreationType.Pattern)
                {
                    var distance;
                    var goUp;
                    if (definition.texturePreset == TexturePresetType.Bumps)
                        goUp = definition.swapPattern ? isOdd(u + v) : !isOdd(u + v);


                    else if (definition.texturePreset == TexturePresetType.Lines)
                        goUp = definition.swapPattern ? isOdd(u) : isOdd(v);

                    distance = goUp ? definition.patternAmplitude / 2 + (definition.shift * definition.patternAmplitude / 2) : -definition.patternAmplitude / 2 + (definition.shift * definition.patternAmplitude / 2);
                    pointDist = distance * dampingFactor;
                }

                if (definition.creationType == TextureCreationType.Splash)
                {
                    for (var attractor in definition.splash)
                    {
                        const objects = attractor.splashObjects;

                        // is there only one item, and is it a point?
                        const objectArray = evaluateQuery(context, objects);
                        const isPoint = size(objectArray) == 1 && !isQueryEmpty(context, qEntityFilter(objectArray[0], EntityType.VERTEX));
                        const side0 = isPoint ? evVertexPoint(context, { "vertex" : objectArray[0] }) : objects;

                        const amplitude = attractor.splashAmplitude;
                        const frequency = attractor.splashFrequency;
                        const range = attractor.splashRange;
                        const distance = getDistanceForRipples(context, { "side0" : side0, "side0IsPoint" : isPoint, "side1" : samplePlane.origin });
                        const rangeFactor = tolerantEquals(range, 0 * meter) ? 1 : remap(min(distance, range), 0 * meter, range, 1, 0); // if the range is set to zero make the range infinite.
                        const rangeFactorToWave = easeLinearRange(rangeFactor);

                        const phaseShift = attractor.splashFlip ? 0 * meter : frequency / 2;

                        const waveSetup = cos((distance - phaseShift) * (360 * degree / frequency));

                        pointDist += (-(amplitude / 2 * waveSetup) + amplitude / 2 * definition.shift) * rangeFactorToWave * dampingFactor;
                    }
                }
            }

            vDistances = append(vDistances, pointDist);

        }
        rippleDistances = append(rippleDistances, vDistances);
    }

    return rippleDistances;
}

export function getRipplePoints(context is Context, id is Id, definition is map, rippleFacePlanes is array, rippleDistances is array) returns array
{
    var points = [];

    for (var u = 0; u < definition.uCount; u += 1)
    {
        var vPoints = [];
        for (var v = 0; v < definition.vCount; v += 1)
        {
            const samplePlane = rippleFacePlanes[(definition.vCount * u) + v];
            const distance = rippleDistances[u][v];
            vPoints = append(vPoints, samplePlane.origin + samplePlane.normal * distance);
        }
        points = append(points, vPoints);
    }
    return points;
}

export function ripplesEditingLogic(context is Context, id is Id, oldDefinition is map, definition is map, isCreating is boolean, specifiedParameters is map, hiddenBodies is Query) returns map
{
    if (definition.cacheMode)
    {
        const useProxyFace = !isQueryEmpty(context, definition.proxyFace);

        const rippleFacePlanes = getRippleFacePlanes(context, id, definition).facePlanes;

        var planesToMeasure = rippleFacePlanes;

        if (useProxyFace)
        {
            planesToMeasure = getRippleFacePlanes(context, id, definition).proxyFacePlanes;
        }

        const approxFace = evApproximateBSplineSurface(context, { "face" : definition.face }).bSplineSurface;
        definition.uCount = approxFace.isUPeriodic ? definition.uCount - 1 : definition.uCount;
        definition.vCount = approxFace.isVPeriodic ? definition.vCount - 1 : definition.vCount;
        definition.cachedDistances = getRippleDistances(context, id, definition, planesToMeasure);
        if (definition.cacheType == CacheType.Distances)
        {
            return definition;
        }
        else if (definition.cacheType == CacheType.Points)
        {
            definition.cachedPoints = getRipplePoints(context, id, definition, rippleFacePlanes, definition.cachedDistances);
            return definition;
        }
    }
    return definition;
}

export function fixVectorArrayFromEditingLogic(points is array, uCount is number, vCount is number) returns array
{
    var newpPoints = [];
    for (var u = 0; u < uCount; u += 1)
    {
        var vPoints = [];
        for (var v = 0; v < vCount; v += 1)
        {
            vPoints = append(vPoints, vector(points[u][v][0], points[u][v][1], points[u][v][2]));
        }
        newpPoints = append(newpPoints, vPoints);
    }
    return newpPoints;
}
