FeatureScript 1634;
import(path : "onshape/std/geometry.fs", version : "1634.0");

export import(path : "556c6fd454acffb7b3e64e1d", version : "0cd8b2822e5fa7f565413440");
export import(path : "ba850300e7a3cb4d99631706", version : "f113e0fd6cd8922b70db6461");

// Icons
icon::import(path : "5f396de7d3f2d5f6d6d34c80", version : "f97dd32b7f83af23bfaa40de");
nutC::import(path : "073a4cea114fde444f4d6c86", version : "24ee46d3c9491bee3905b092");
nutT::import(path : "5526c2ea2e70507f7459f87e", version : "f4bf3e3c1ac52585af9b9db5");
nutW::import(path : "f26525d8aa0a48f99e725a14", version : "5dcf9e8553a1315b70dab143");

annotation { "Feature Type Name" : "Nut spec variable",
        "Editing Logic Function" : "npEditLogic",
        "Feature Name Template" : "#d",
        "Icon" : icon::BLOB_DATA, }
export const nutSpecVariable = defineFeature(function(context is Context, id is Id, definition is map)
    precondition
    {
        // this gives editing logic what it's looking for
        annotation { "Name" : "use nut spec", "Default" : false, "UIHint" : UIHint.ALWAYS_HIDDEN }
        definition.useNutSpec is boolean;
        
        annotation { "Name" : "Name" }
        definition.variableName is string;

        nutSpecPredicate(definition);
    }
    {
        setVariable(context, "@NutSpec" ~ definition.variableName, { "nutW" : definition.nutW, "nutT" : definition.nutT, "nutC" : definition.nutC, "shape" : definition.connectorStandard.shape });
        setFeatureComputedParameter(context, id, { "name" : "d", "value" : definition.variableName });
    });
