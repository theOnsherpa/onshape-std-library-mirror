// Arul Suresh's (@lemon123) editing logic 👇 (with tweaks)

export function npEditLogic(context is Context, id is Id, oldDefinition is map, definition is map,
    isCreating is boolean, specifiedParameters is map, hiddenBodies is Query) returns map
{
    if (!definition.useNutSpec)
    {
        if (oldDefinition.connectorStandard != definition.connectorStandard)
        {
            definition = updateTSDefinitionWithStandard(oldDefinition, definition);
        }
        definition = setToCustomIfStandardViolated(definition);
    }

    return definition;
}

export function updateTSDefinitionWithStandard(oldDefinition is map, definition is map) returns map
{
    var table = getLookupTable(nutPocketTable, definition.connectorStandard);

    for (var entry in table)
    {
        definition[entry.key] = lookupTableFixExpression(entry.value);
    }

    return definition;
}

function setToCustomIfStandardViolated(definition is map) returns map
{
    var table = getLookupTable(nutPocketTable, definition.connectorStandard);

    if (isLookupTableViolated(definition, table))
    {
        definition.connectorStandard = lookupTablePath({ "standard" : "Custom", "shape" : lookupTablePath(definition.connectorStandard)["shape"] });
    }

    return definition;
}



export function getPrinterZDirection(context is Context, definition is map)
{
    var printerZ;

    if (definition.printerZ.subqueries == [])
    {
        printerZ = WORLD_COORD_SYSTEM.zAxis;
    }
    else
    {
        printerZ = extractDirection(context, definition.printerZ);
    }
    if (definition.flipZ)
    {
        printerZ = -printerZ;
    }

    // size the display arrow appropriately relative to part size

    var arrowLength = max(
    25 * millimeter,
    evDistance(context, {
                    "side0" : qEverything(EntityType.BODY)->qBodyType(BodyType.SOLID)->qFarthestAlong(printerZ),
                    "side1" : vector(0, 0, 0) * meter,
                    "maximum" : true
                }).distance
    );

    addDebugArrow(context, zeroVector(3) * millimeter, printerZ * arrowLength, arrowLength * .1, DebugColor.BLUE);

    return printerZ;
}

export enum nutBoundingType
{
    annotation { "Name" : "Blind" }
    BLIND,
    annotation { "Name" : "Up to next" }
    UP_TO_NEXT,
    annotation { "Name" : "Up to face" }
    UP_TO_SURFACE,
    annotation { "Name" : "Up to part" }
    UP_TO_BODY,
    annotation { "Name" : "Up to vertex" }
    UP_TO_VERTEX
}

export predicate nutBoundParametersPredicate(definition is map)
{
    if (definition.endBound == BoundingType.BLIND)

    {
        annotation { "Name" : "Depth" }
        isLength(definition.depth, LENGTH_BOUNDS);
    }
    else if (definition.endBound == BoundingType.UP_TO_SURFACE)

    {
        annotation { "Name" : "Up to face",
                    "Filter" : (EntityType.FACE && SketchObject.NO) || BodyType.MATE_CONNECTOR,
                    "MaxNumberOfPicks" : 1 }
        definition.endBoundEntityFace is Query;
    }
    else if (definition.endBound == BoundingType.UP_TO_BODY)

    {
        annotation { "Name" : "Up to surface or part",
                    "Filter" : EntityType.BODY && (BodyType.SOLID || BodyType.SHEET) && SketchObject.NO,
                    "MaxNumberOfPicks" : 1 }
        definition.endBoundEntityBody is Query;
    }
    else if (definition.endBound == BoundingType.UP_TO_VERTEX)

    {
        annotation { "Name" : "Up to vertex or mate connector",
                    "Filter" : QueryFilterCompound.ALLOWS_VERTEX,
                    "MaxNumberOfPicks" : 1 }
        definition.endBoundEntityVertex is Query;
    }

    if (definition.endBound == BoundingType.UP_TO_NEXT ||
        definition.endBound == BoundingType.UP_TO_SURFACE ||
        definition.endBound == BoundingType.UP_TO_BODY ||
        definition.endBound == BoundingType.UP_TO_VERTEX)
    {
        annotation { "Name" : "Offset distance", "Column Name" : "Has offset", "UIHint" : ["DISPLAY_SHORT", "FIRST_IN_ROW"] }
        definition.hasOffset is boolean;

        if (definition.hasOffset)
        {
            annotation { "Name" : "Offset distance", "UIHint" : UIHint.DISPLAY_SHORT }
            isLength(definition.offsetDistance, LENGTH_BOUNDS);

            annotation { "Name" : "Opposite direction", "Column Name" : "Offset opposite direction", "UIHint" : UIHint.OPPOSITE_DIRECTION }
            definition.offsetOppositeDirection is boolean;
        }
    }
}

export function getNutCorner(width is ValueWithUnits, shape is string)
{
    var nut = {};
    if (shape == "Hex")
    {
        nut.corner = vector(width / (sqrt(3)), 0 * width);
        nut.sides = 6;
    }

    else if (shape == "Square")
    {
        nut.corner = vector(width / 2, width / 2);
        nut.sides = 4;
    }
    return nut;
}

export function getNutPlane(context is Context, location is Query, thickness is ValueWithUnits, offset is ValueWithUnits, angle is ValueWithUnits)
{
    var nutPlane;

    // plane at Location Point coplanar to sketchPlane
    try silent
    {
        var sketchPlane = evOwnerSketchPlane(context, {
                "entity" : location
            });
        var normal = sketchPlane.normal;
        var x = sketchPlane.x;
        var origin = evVertexPoint(context, {
                "vertex" : location
            });
        nutPlane = plane(origin, normal, x);
    }

    // plane from mate connector
    try silent
    {
        var mateCoord = evMateConnector(context, {
                "mateConnector" : location
            });
        var normal = mateCoord.zAxis;
        var x = mateCoord.xAxis;
        nutPlane = plane(mateCoord);
    }
    // moving the front plane by the thickness of the nut
    nutPlane.origin = nutPlane.origin - ((thickness + offset) * nutPlane.normal);

    // rotating the plane if needed
    var roationTransform = rotationAround(line(nutPlane.origin, nutPlane.normal), angle).linear;
    nutPlane.x = roationTransform * nutPlane.x;

    return nutPlane;
}

export function displayNut(context is Context, id is Id, nutPlane is map, nut is map, nutThickness is ValueWithUnits)
{
    // Adding a nut to display
    var nutSketch = newSketchOnPlane(context, id + "nutSketch", {
            "sketchPlane" : nutPlane
        });

    skRegularPolygon(nutSketch, "nut", {
                "center" : vector(0, 0) * inch,
                "firstVertex" : nut.corner,
                "sides" : nut.sides
            });

    skSolve(nutSketch);

    opExtrude(context, id + "nutExtrude", {
                "entities" : qSketchRegion(id + "nutSketch"),
                "direction" : nutPlane.normal,
                "endBound" : BoundingType.BLIND,
                "endDepth" : nutThickness,
            });

    var nutBody = qCreatedBy(id + "nutExtrude", EntityType.BODY);
    var nutEdges = qOwnedByBody(nutBody, EntityType.EDGE); /*adding edges since faces can't be seen through parts*/

    var debugEntities = qUnion([nutBody, nutEdges]);

    addDebugEntities(context, debugEntities, DebugColor.MAGENTA);

    opDeleteBodies(context, id + "deleteBodies1", {
                "entities" : qUnion([qCreatedBy(id + "nutExtrude"), qCreatedBy(id + "nutSketch")])
            });
}

export function moveFaceFeatureByOffset(context is Context, id is Id, faces is Query, offsetDistance is ValueWithUnits)
{
    var moveFaceDefinition = {
        "outputType" : MoveFaceOutputType.MOVE,
        "moveFaces" : faces,
        "moveFaceType" : MoveFaceType.OFFSET,
        "limitType" : MoveFaceBoundingType.BLIND,
        "offsetDistance" : offsetDistance,
        "oppositeDirection" : true
    };
    moveFace(context, id, moveFaceDefinition);
}


