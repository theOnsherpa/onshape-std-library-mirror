}

export function getPocketDirection(definition is map, nutPlane is Plane, printerZ is Vector) returns Vector
{
    var pocketDirection;
    if (definition.insertionType == insertionType.Pocket)
    {
        pocketDirection = nutPlane.normal;
    }
    else if (definition.insertionType == insertionType.Slot)
    {
        pocketDirection = nutPlane.x;
    }
    else if (definition.insertionType == insertionType.Embedded)
    {
        // finding the angle between printer z and nut. the min function makes it so the angle never exceeds 90°.
        var nutToPrinterAngle = min(angleBetween(printerZ, nutPlane.normal), angleBetween(-printerZ, nutPlane.normal));
        if (nutToPrinterAngle > 45 * degree)
        {
            // finds a direction for the side-inserted support that's in the nut plane, and points as close to printer z as possible. I'm doing this by making a point way above the nutPlane.origin in the printerZ direction then projecting that point back to the nut plane and making a line.
            var projectedPoint = project(nutPlane, nutPlane.origin + 100 * meter * printerZ);
            pocketDirection = line(nutPlane.origin, projectedPoint).direction;
        }
        else
        {
            pocketDirection = printerZ;
        }
    }
    // flip the pocket direction if needed
    pocketDirection = definition.flipExtrude ? -pocketDirection : pocketDirection;

    return pocketDirection;
}


/**
 * finds support body faces adjacent to the nut. Of that list, finds faces at too sharp an angle to 3D print well and deletes them. returns a query for the faces adjacent to the nut.
 */
export function getAdjacentNutFacesAndDeleteSliverFaces(context is Context, id is Id, pocketFaces is Query, pocketDirection is Vector) returns Query
{                   var sliverDeletionAngle = 15*degree;
                    var pocketFacesArray = evaluateQuery(context, pocketFaces);
                    var nutFaces = [];
                    var deleteFaces =[];
                    var i = 0; /*helps with duplicate IDs in case more than one face should be deleted*/
                    for (var face in pocketFacesArray)
                    {
                        var angle;
                     try
                     {
                         
                         angle = angleBetween(evFaceTangentPlane(context, {
                                        "face" : face,
                                        "parameter" : vector(0.5, 0.5)
                                    }).normal, pocketDirection);
                     }
                     catch (error)
                     {
                         println("failed on "~i);
                         debug(context, face, DebugColor.RED);
                     }   

                        if (angle > 90 * degree + 0.00001 * degree) /*is the face facing away from the pocket direction? then it's adjacent to the nut*/
                        {
                            if (angle < 90 * degree + sliverDeletionAngle) /*of the adjacent faces, which are so thin that they won't print well? delete them, otherwise add them to a list for offsetting with clearance later*/
                            {
                                deleteFaces = append(deleteFaces, face);
                            }
                            else
                            {
                                nutFaces = append(nutFaces, face);
                            }
                        }
                        i += 1;
                    }
                    if (deleteFaces != [])
                    {
                                opDeleteFace(context, id + "deleteFace1" + i, {
                                            "deleteFaces" : qUnion(deleteFaces),
                                            "includeFillet" : false,
                                            "capVoid" : false,
                                            "leaveOpen" : false
                                        });
                    }
                    
                    
                    return qUnion(nutFaces);
}
