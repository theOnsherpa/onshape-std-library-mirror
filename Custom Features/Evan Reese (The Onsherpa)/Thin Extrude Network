annotation { "Feature Type Name" : "Thin extrude network", "Feature Type Description" : "" }
export const thinExtrudeNetwork = defineFeature(function(context is Context, id is Id, definition is map)
    precondition
    {
        annotation { "Name" : "Sketch edges to extrude", "Filter" : EntityType.EDGE && SketchObject.YES }
        definition.edges is Query;

        annotation { "Name" : "My Length" }
        isLength(definition.depth, LENGTH_BOUNDS);

        annotation { "Name" : "Flip", "UIHint" : UIHint.OPPOSITE_DIRECTION }
        definition.flip is boolean;

        annotation { "Name" : "Thickness" }
        isLength(definition.thickness, { (millimeter) : [1e-6, /* min (inclusive) */
                            5.0, /* default */
                            10000 /* max (inclusive) */] } as LengthBoundSpec);


    }
    {
        var direction = !definition.flip ? evOwnerSketchPlane(context, { "entity" : definition.edges }).normal : -(evOwnerSketchPlane(context, { "entity" : definition.edges }).normal);

        var edges = definition.edges;

        forEachEntity(context, id + "extrudeEdge", edges, function(edge is Query, id is Id)
            {
                extrude(context, id + "extrude1", {
                            "bodyType" : ExtendedToolBodyType.THIN,
                            "entities" : edge,
                            "endBound" : BoundingType.BLIND,
                            "depth" : !definition.flip ? definition.depth : -definition.depth,
                            "wallShape" : edge,
                            "thickness1" : definition.thickness / 2,
                            "thickness2" : definition.thickness / 2,
                        });
            });
            
        // cylinders at end points
                var endPointQueries = qAdjacent(definition.edges, AdjacencyType.VERTEX, EntityType.VERTEX);
        endPointQueries = evaluateQuery(context, endPointQueries);

        var endPoints = [];
        for (var point in endPointQueries)
        {
            endPoints = append(endPoints, evVertexPoint(context, { "vertex" : point }));
        }

        endPoints = deduplicatePoints(endPoints);
        
        for (var i = 0; i < size(endPoints); i += 1)
        {
            fCylinder(context, id + "cylinder1" + i, {
                    "topCenter" : endPoints[i],
                    "bottomCenter" : endPoints[i] + (direction * definition.depth),
                    "radius" : definition.thickness/2
            });
        }
        
        opBoolean(context, id + "boolean1", {
                "tools" : qCreatedBy(id, EntityType.BODY),
                "operationType" : BooleanOperationType.UNION
        });
    });

