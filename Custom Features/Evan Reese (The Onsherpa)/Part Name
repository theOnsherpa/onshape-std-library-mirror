    annotation { "Name" : "One" }
    ONE,
    annotation { "Name" : "Two" }
    TWO,
    annotation { "Name" : "Three" }
    THREE,
    annotation { "Name" : "Four" }
    FOUR,
    annotation { "Name" : "Five" }
    FIVE,
    annotation { "Name" : "Six" }
    SIX
}

