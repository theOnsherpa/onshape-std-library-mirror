export enum DisplayUnit
{
    Millimeter,
    Centimeter,
    Meter,
    Inch,
    Foot,
    Yard,
    Degree,
    Radian,
}

export const unitConversion = {
        "Millimeter" : millimeter,
        "Centimeter" : centimeter,
        "Meter" : meter,
        "Inch" : inch,
        "Foot" : foot,
        "Yard" : yard,
        "Degree" : degree,
        "Radian" : radian,
    };

export const DECIMAL_PLACE_BOUNDS = { (unitless) : [-1e6, 3, 1e6] } as IntegerBoundSpec;

export const displayUnitDescription = "Determines what number comes out of the expression if it has units (length or angle). For example, if your expression evaluates to '1*inch', then selecting 'Inch' here results in '1', but selecting 'Millimeter' results in '25.4'";
