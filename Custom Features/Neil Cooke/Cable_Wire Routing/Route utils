export function getColor(wireData is map) returns Color
{
    var text = "";

    try silent
    {
        text = trim(toLower(wireData.color));
    }

    if (text == "")
        text = "gray";

    const rgb = split(text, ",");
    const hex = match(text, "#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})").captures;

    var col = [0.65, 0.65, 0.65]; // gray

    if (hex != [])
    {
        for (var index in [0, 1, 2])
            col[index] = hexToDecimal(hex[index + 1]);
    }
    else if (size(rgb) == 3)
    {
        for (var index in [0, 1, 2])
            col[index] = stringToNumber(rgb[index]) / 255;
    }
    else
    {
        const colorChart = {
                "red" : color(1, 0, 0),
                "green" : color(0, 1, 0),
                "blue" : color(0, 0, 1),
                "black" : color(0, 0, 0),
                "yellow" : color(1, 1, 0),
                "white" : color(1, 1, 1),
                "magenta" : color(1, 0, 1),
                "purple" : color(1, 0, 1),
                "violet" : color(1, 0, 1),
                "pink" : color(1, 0.4, 0.8),
                "turquoise" : color(0.25, 0.88, 0.82),
                "cyan" : color(0, 1, 1),
                "grey" : color(0.65, 0.65, 0.65),
                "gray" : color(0.65, 0.65, 0.65),
                "orange" : color(1, 0.5, 0),
                "brown" : color(0.6, 0.3, 0),
                "copper" : color(0.9, 0.5, 0.3)
            };

        return colorChart[text];
    }

    return color(col[0], col[1], col[2]);
}

