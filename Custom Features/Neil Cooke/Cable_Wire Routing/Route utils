export function setData(context is Context, input is array, class is string)
{
    var data = getData(context, class);
    var order = data.order == undefined ? [] : data.order;

    if (class == "harnesses")
    {
        order = append(order, input[0].harnessId[0]);

        var wires = [];

        for (var wire in input[0].wireIds)
        {
            const cable = getData(context, "cables")[wire];

            if (cable != undefined)
            {
                for (var cableWire in cable.wireIds)
                    wires = append(wires, { (cableWire) : { "harnessId" : input[0].harnessId[0] } });
            }
            else
                wires = append(wires, { (wire) : { "harnessId" : input[0].harnessId[0] } });
        }

        if (wires != [])
            setData(context, wires, "wires");
    }
    else if (class == "cables")
    {
        for (var item in input)
        {
            for (var key in keys(item))
            {
                var result = item[key];
                data[key] = result;
                var wires = [];

                for (var wire in result.wireIds)
                    wires = append(wires, { (wire) : { "cableId" : key } });

                setData(context, wires, "wires");
            }
        }
    }
    else
    {
        for (var item in input)
        {
            for (var key in keys(item))
            {
                if (data[key] == undefined)
                {
                    data[key] = item[key];
                    order = class == "refs" ? [] : append(order, key);
                }
                else
                    data[key] = mergeMaps(data[key], item[key]);
            }
        }
    }

    setAttribute(context, {
                "entities" : qOrigin(EntityType.BODY),
                "name" : class,
                "attribute" : order == [] ? data : mergeMaps(data, { "order" : order })
            });
}

