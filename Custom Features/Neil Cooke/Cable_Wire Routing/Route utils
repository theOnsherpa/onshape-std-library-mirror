export function getUnits(context is Context, definition is map)
{
    definition.wireLengthUnits = getGlobalVariable(context, "wireLengthUnits", millimeter);

    if (tolerantEquals(definition.wireLengthUnits, millimeter))
        definition.units = "mm";
    else if (tolerantEquals(definition.wireLengthUnits, centimeter))
        definition.units = "cm";
    else if (tolerantEquals(definition.wireLengthUnits, meter))
        definition.units = "m";
    else if (tolerantEquals(definition.wireLengthUnits, inch))
        definition.units = "in";
    else if (tolerantEquals(definition.wireLengthUnits, foot))
        definition.units = "ft";
    else if (tolerantEquals(definition.wireLengthUnits, yard))
        definition.units = "yd";

    return definition;
}

export function updateWireAttributes(context is Context, wireSegments is Query, attributes is map)
{
    for (var wireSegment in evaluateQuery(context, wireSegments))
    {
        var wireAttributes = getAttribute(context, {
                "entity" : wireSegment,
                "name" : "wireSegment"
            });

        if (wireAttributes == undefined)
            wireAttributes = {};

        setAttribute(context, {
                    "entities" : wireSegment,
                    "name" : "wireSegment",
                    "attribute" : mergeMaps(wireAttributes, attributes)
                });
    }
}

// geometry functions

export function getClosest(entities is Query, point is Vector)
{
    return qWithinRadius(entities, point, TOLERANCE.booleanDefaultTolerance * meter);
}

export function removeEdge(context is Context, edges is array, edge is Query)
{
    var index = -1;

    for (var i, item in edges)
    {
        if (areQueriesEquivalent(context, item, edge))
        {
            index = i;
            break;
        }
    }

    if (index != -1)
        return removeElementAt(edges, index);

    return edges;
}

export function getEdgeChains(context is Context, edges is array)
{
    var network = false;
    var edgeChains = [];
    const edgesCopy = edges;

    while (size(edges) > 0)
    {
        var chain = [];

        for (var edge in edges) // check for selected faces first
            if (!isQueryEmpty(context, qEntityFilter(edge, EntityType.FACE)))
            {
                edgeChains = edgeChains->append(edge);
                edges = removeEdge(context, edges, edge);
            }

        if (edges == [])
            break;

        // Get next start edge
        for (var edge in edges)
        {
            const vertices = qAdjacent(edge, AdjacencyType.VERTEX, EntityType.VERTEX);
            var connectedEdges = qNothing();

            for (var vertex in evaluateQuery(context, vertices))
                connectedEdges = qUnion(connectedEdges, getClosest(qUnion(edges), evVertexPoint(context, {
                                        "vertex" : vertex
                                    }))->qSubtraction(edge));

            // edge has three or more neighbours making it a curve network
            if (size(evaluateQuery(context, connectedEdges)) > 2)
            {
                network = true;
                break;
            }

            // edge has one or zero neighbours making it a start edge
            if (size(evaluateQuery(context, connectedEdges)) < 2)
            {
                chain = [edge]; // start of chain is now edge
                edges = removeEdge(context, edges, edge);
                break;
            }
        }

        if (network || chain == []) // curve network
        {
            network = true;
            break;
        }

        // Search remaining edges - a closed profile will fail but that's to be expected
        for (var _ in edges)
        {
            const vertices = qAdjacent(last(chain), AdjacencyType.VERTEX, EntityType.VERTEX);

            // edge has three or more neighbours making it a curve network
            if (size(evaluateQuery(context, vertices)) > 2)
            {
                network = true;
                break;
            }

            var nextEdge = qNothing(); // will only contain one edge

            for (var vertex in evaluateQuery(context, vertices))
                nextEdge = qUnion(nextEdge, getClosest(qUnion(edges), evVertexPoint(context, {
                                        "vertex" : vertex
                                    }))->qSubtraction(last(chain)));

            if (isQueryEmpty(context, nextEdge))
                break;

            chain = chain->append(nextEdge);
            edges = removeEdge(context, edges, nextEdge);
        }

        edgeChains = edgeChains->append(qUnion(chain));
    }
    if (network)
        edgeChains = [qUnion(edgesCopy)];

    return edgeChains;
}

export function copyWireBody(context is Context, id is Id, wire is Query, attributes is map)
{
    try silent
    {
        if (isQueryEmpty(context, qEntityFilter(wire, EntityType.BODY)))
        {
            opExtractWires(context, id, {
                        "edges" : wire
                    });
        }
        else
        {
            opPattern(context, id, {
                        "entities" : wire,
                        "transforms" : [identityTransform()],
                        "instanceNames" : ["1"],
                        "copyPropertiesAndAttributes" : false
                    });
        }

        updateWireAttributes(context, qCreatedBy(id, EntityType.BODY), attributes);
    }

    return qCreatedBy(id, EntityType.EDGE);
}

function sweepCovering(context is Context, id is Id, definition is map, diameter is ValueWithUnits, color is string, wires is Query)
{
    const start = evEdgeTangentLine(context, {
                "edge" : qNthElement(wires, 0),
                "parameter" : 0
            });

    const sketchStart = newSketchOnPlane(context, id + "sketchCovering", {
                "sketchPlane" : plane(start.origin, start.direction)
            });

    skCircle(sketchStart, "OD", {
                "center" : vector(0, 0) * meter,
                "radius" : diameter / 2
            });

    skSolve(sketchStart);

    try silent
    {
        opSweep(context, id + "sweepCovering", {
                    "profiles" : qSketchRegion(id + "sketchCovering", false),
                    "path" : wires
                });
    }

    opDeleteBodies(context, id + "deleteCovering", {
                "entities" : qCreatedBy(id + "sketchCovering", EntityType.BODY)
            });

    setProperty(context, {
                "entities" : qCreatedBy(id + "sweepCovering", EntityType.FACE),
                "propertyType" : PropertyType.APPEARANCE,
                "value" : getColor(color)
            });

    setAttribute(context, {
                "entities" : qNonCapEntity(id + "sweepCovering", EntityType.FACE),
                "name" : "diameter",
                "attribute" : diameter
            });

    setAttribute(context, {
                "entities" : qCreatedBy(id + "sweepCovering", EntityType.BODY),
                "name" : "flatten",
                "attribute" : true
            });
}

function makeCovering(context is Context, id is Id, definition is map, harness is map)
{
    const wires = qUnion(harness.edges);
    const diameter = definition.bundleOverride ? definition.bundleOverrideDiameter : harness.diameter;

    sweepCovering(context, id, definition, diameter, definition.coveringColor, wires);

    if (!definition.bundleOverride)
        return;

    var errors = false;

    // for modifying bundle covers from previous features
    for (var i, bundle in definition.bundleOverrides)
    {
        for (var j, covering in evaluateQuery(context, bundle.overrideCoverings))
        {
            const bundleDiameter = getAttribute(context, {
                        "entity" : covering,
                        "name" : "diameter"
                    });

            if (bundleDiameter == undefined)
            {
                errors = true;
                continue;
            }

            const coveringId = id + "editCovering" + i + j;
            const bundleCenterline = copyWireBody(context, coveringId + "centerline", qDependency(covering), {});

            var sweepCenterline;
            var parameters = [];

            for (var end in [0, 1])
            {
                const point = evEdgeTangentLine(context, {
                                "edge" : wires, // test different selection scenarios
                                "parameter" : end
                            }).origin;

                const distance = evDistance(context, {
                            "side0" : bundleCenterline,
                            "side1" : point
                        });

                if (distance.distance < 1e-6 * meter)
                    parameters = append(parameters, distance.sides[0].parameter);
            }

            var deleteEdges = [];

            if (parameters != [] && tolerantWithinExclusive(parameters[0], 0, 1))
            {
                opSplitEdges(context, coveringId + "splitEdges", {
                            "edges" : bundleCenterline,
                            "parameters" : [parameters]
                        });

                for (var edge in evaluateQuery(context, bundleCenterline))
                {
                    for (var end in [0, 1])
                    {
                        const point = evEdgeTangentLine(context, {
                                        "edge" : edge, // test different selection scenarios
                                        "parameter" : end
                                    }).origin;

                        const distance = evDistance(context, {
                                    "side0" : wires,
                                    "side1" : point
                                });

                        if (distance.distance > 1e-6 * meter)
                            deleteEdges = append(deleteEdges, edge);
                    }
                }
            }

            sweepCenterline = copyWireBody(context, coveringId + "sweepCenterline", qSubtraction(bundleCenterline, qUnion(deleteEdges)), {});

            if (sweepCenterline != undefined && !isQueryEmpty(context, sweepCenterline))
            {
                sweepCovering(context, coveringId + "sweep", definition, bundle.overrideCoveringDiameter, bundle.overrideCoveringColor, sweepCenterline);

                updateWireAttributes(context, qOwnerBody(sweepCenterline), { "covering" : true, "harness" : { "diameter" : bundle.overrideCoveringDiameter, "color" : bundle.overrideCoveringColor, "parentId" : definition.wires[0].id } });
            }

            opDeleteBodies(context, coveringId + "deleteBodies", {
                        "entities" : bundleCenterline
                    });
        }
    }

    if (errors && !isEditing(definition))
        errorInfo(context, id, "Selections include non-bundle geometry and will be ignored");
}

function makeHarness(context is Context, id is Id, definition is map, wires is map, refs is Query, wireName is string)
{
    var wireType = "Cable";
    var harnessId = resize(id, 1);

    if (!definition.cable)
    {
        id = append(id, wireName);
        wireType = "Wire";
    }

    const currentWires = qCreatedBy(id, EntityType.BODY)->qFlattenedCompositeParts()->qBodyType(BodyType.WIRE)->qSketchFilter(SketchObject.NO);
    var compositeWireBody = qCompositePartsContaining(currentWires);
    const sharedRefs = qSubtraction(refs->qCompositePartsContaining(), refs)->qFlattenedCompositeParts()->qBodyType(BodyType.WIRE);

    const refsExist = !isQueryEmpty(context, refs);
    const sharedRefsExist = !isQueryEmpty(context, sharedRefs);

    if (sharedRefsExist)
        compositeWireBody = qCompositePartsContaining(sharedRefs);

    if (definition.bundle)
    {
        const harnessOrder = getData(context, "harnesses").order;
        var earliestHarness;

        if (harnessOrder != undefined)
            earliestHarness = size(harnessOrder);

        const bundle = getHarnessData(context, definition, currentWires);

        for (var key, harness in bundle)
        {
            if (harness.edges != [] && harness.diameter != undefined)
            {
                if (definition.show)
                    makeCovering(context, id + key, definition, harness);

                const parentId = [harness.parentId] as Id;
                harnessId = parentId;

                if (harnessOrder != undefined)
                {
                    const harnessIndex = argIn(harness.parentId, harnessOrder);

                    if (harnessIndex != undefined)
                    {
                        if (harnessIndex < earliestHarness)
                            earliestHarness = harnessIndex;

                        harnessId = [harnessOrder[earliestHarness]] as Id;
                    }
                }

                compositeWireBody = qCompositePartsContaining(qCreatedBy(harnessId, EntityType.BODY));

                if (parentId != harnessId)
                    refs = qUnion(refs, qCompositePartsContaining(qCreatedBy(parentId, EntityType.BODY)));
            }
        }
    }

    try silent // add connectors to wire
    {
        opModifyCompositePart(context, id + "harness", {
                    "composite" : compositeWireBody,
                    "toAdd" : qUnion(qCreatedBy(id, EntityType.BODY)->qSketchFilter(SketchObject.NO), refs)
                });
    }

    const existingWires = getHarnessWireId(context, definition, compositeWireBody, wireName);

    if (refsExist && sharedRefsExist || definition.bundle)
        wireType = "Harness";

    var wireNames = "";
    var harnessWireIds = [];

    for (var i, wire in existingWires)
    {
        var wireName;

        if (i > 0)
            wireNames ~= "/";

        if (wire.cableName != undefined)
            wireName = wire.cableName;
        else
            wireName = wire.wireId;

        wireNames ~= wireName;

        if (wireType == "Harness")
        {
            if (i == 0)
                harnessId = getFirstHarnessId(context, wires, wireName);

            harnessWireIds = append(harnessWireIds, wireName);
        }
    }

    var harnessName = wireType ~ ": " ~ wireNames;

    if (length(harnessName) > 256)
    {
        if (!isEditing(definition))
            errorInfo(context, id, wireType ~ " name is too long and will be truncated. Try creating a cable and add a cable ID to group wire names.");

        const truncated = resize(splitIntoCharacters(harnessName), 256);
        harnessName = "";

        for (var char in truncated)
            harnessName ~= char;
    }

    setProps(context, compositeWireBody, harnessName);

    return { "wireIds" : harnessWireIds, "harnessId" : harnessId };
}

export function isEditing(definition is map)
{
    var editing = false;

    for (var wire in definition.wires)
        if (wire.edit && wire.visible)
            editing = true;

    return editing;
}

export function makeWire(context is Context, id is Id, definition is map)
{
    var wireIds = getWireIds(context, definition).wires;

    if (wireIds == [])
        return;

    var connectors = [];
    var harnessIds = [];
    var harnessId;
    const wires = getData(context, "wires");
    const isCable = definition.cable;
    const cableName = isCable ? wires[wireIds[0]].cableId : "";
    const cableDiameter = isCable ? wires[wireIds[0]].cable.diameter : undefined;
    const cableBend = isCable ? wires[wireIds[0]].cableBend : undefined;
    const cableBendError = isCable ? wires[wireIds[0]].cableBendError : undefined;
    const wireBodies = qCreatedBy(id, EntityType.BODY)->qBodyType(BodyType.WIRE)->qSketchFilter(SketchObject.NO);
    const solidBodies = qCreatedBy(id, EntityType.BODY)->qBodyType(BodyType.SOLID);

    for (var wireId in wireIds)
    {
        var refs = [];
        var strips = [];
        const wire = wires[wireId];
        const featureId = id + wireId;

        if (wire == undefined || wire.featureId == undefined) // required for editing logic and frequent user ID changes
            continue;

        const wireStart = qHasAttributeWithValueMatching(qCreatedBy(wire.featureId), "wireSegment", {
                        "section" : "start"
                    })->qOwnedByBody(EntityType.EDGE);

        const wireMiddle = qHasAttributeWithValueMatching(qCreatedBy(wire.featureId), "wireSegment", {
                        "section" : "wire"
                    })->qOwnedByBody(EntityType.EDGE);

        const wireEnd = qHasAttributeWithValueMatching(qCreatedBy(wire.featureId), "wireSegment", {
                        "section" : "end"
                    })->qOwnedByBody(EntityType.EDGE);

        const wirePath = qUnion([wireStart, wireMiddle, wireEnd]);
        const wireSections = definition.cable ? [wireStart, wireEnd] : [wirePath];

        for (var s, section in wireSections)
        {
            if (isQueryEmpty(context, section))
                continue;

            const sectionEnd = ["from", "to"][s];

            if (definition.show)
            {
                try silent
                {
                    const wireSketch = newSketchOnPlane(context, featureId + ("sketch" ~ sectionEnd), {
                                "sketchPlane" : plane(wire[sectionEnd].vector.origin, wire[sectionEnd].vector.direction)
                            });

                    skCircle(wireSketch, "OD", {
                                "center" : vector(0, 0) * meter,
                                "radius" : wire.diameter / 2
                            });

                    skSolve(wireSketch);

                    opSweep(context, featureId + ("sweep" ~ sectionEnd), {
                                "profiles" : qSketchRegion(featureId + ("sketch" ~ sectionEnd)),
                                "path" : section
                            });

                    setProperty(context, {
                                "entities" : qCreatedBy(featureId + ("sweep" ~ sectionEnd), EntityType.FACE),
                                "propertyType" : PropertyType.APPEARANCE,
                                "value" : getColor(wire.color)
                            });

                    setAttribute(context, {
                                "entities" : qNonCapEntity(featureId + ("sweep" ~ sectionEnd), EntityType.FACE),
                                "name" : "diameter",
                                "attribute" : wire.diameter
                            });

                    setAttribute(context, {
                                "entities" : qCreatedBy(featureId + ("sweep" ~ sectionEnd), EntityType.BODY),
                                "name" : "flatten",
                                "attribute" : true
                            });

                    if (wire.core <= wire.diameter) // add strip length copper core
                    {
                        const stripEnd = definition.cable ? [sectionEnd] : ["from", "to"];

                        for (var end in stripEnd)
                        {
                            const endFace = definition.cable ?
                                qCapEntity(featureId + ("sweep" ~ end), CapType.END, EntityType.FACE) :
                                qCapEntity(featureId + ("sweepfrom"), end == "to" ? CapType.START : CapType.END, EntityType.FACE);

                            if (wire[sectionEnd].strip > 0 * meter)
                            {
                                opExtrude(context, featureId + ("strip" ~ end), {
                                            "entities" : endFace,
                                            "direction" : evPlane(context, {
                                                        "face" : endFace
                                                    }).normal,
                                            "endBound" : BoundingType.BLIND,
                                            "endDepth" : wire[end].strip
                                        });

                                setProperty(context, {
                                            "entities" : qCreatedBy(featureId + ("strip" ~ end), EntityType.FACE),
                                            "propertyType" : PropertyType.APPEARANCE,
                                            "value" : color(0.9, 0.5, 0.3) // copper
                                        });

                                strips = append(strips, qNonCapEntity(featureId + ("strip" ~ end), EntityType.FACE));
                            }
                        }
                    } // end of strip length
                }
                catch
                {
                    errorWarning(context, id, "Unable to create all wire geometry. Check for possible minimum bend radius violation.");
                }
            } // end of show

            const refEnd = definition.cable ? [sectionEnd] : ["from", "to"];

            for (var end in refEnd)
            {
                if (wire[end].refId != false)
                    for (var refId in wire[end].refId)
                        refs = append(refs, qModifiableEntityFilter(qCreatedBy(refId, EntityType.BODY)));
            }

            connectors = append(connectors, (qUnion(refs)));

        } // end of sections

        if (!isQueryEmpty(context, qUnion(strips)))
        {
            opOffsetFace(context, featureId + "offset", { // strips offset here for performance
                        "moveFaces" : qUnion(strips),
                        "offsetDistance" : (wire.diameter - wire.core) / -2
                    });
        }

        if (!definition.cable)
        {
            try silent
            {
                const compositeId = featureId + "composite";

                // group all individual wire entities together
                opCreateCompositePart(context, compositeId, {
                            "bodies" : qOwnerBody(qUnion(wirePath, qCreatedBy(featureId, EntityType.BODY)->qBodyType(BodyType.SOLID))),
                            "closed" : true
                        });

                try
                {
                    const harness = makeHarness(context, id, definition, wires, qUnion(refs), wireId);
                    harnessIds = harness.wireIds;
                    harnessId = harness.harnessId;
                }
                catch
                {
                    errorWarning(context, id, "Bundle thickness too large for route radius.");
                }
            }
        }
    } // end of wire loop

    if (definition.cable)
    {
        var refs = [];
        const wire = wires[definition.wires[0].id];

        if (definition.show)
        {
            try silent
            {
                const cableSegments = qHasAttributeWithValueMatching(wireBodies, "wireSegment", {
                                "section" : "cable"
                            })->qOwnedByBody(EntityType.EDGE);

                const cablePath = constructPath(context, cableSegments);

                const cableStart = evPathTangentLines(context, cablePath, [0]).tangentLines[0];

                const cableSketch = newSketchOnPlane(context, id + "cableSketch", {
                            "sketchPlane" : plane(cableStart.origin, cableStart.direction)
                        });

                skCircle(cableSketch, "OD", {
                            "center" : vector(0, 0) * meter,
                            "radius" : wire.cable.diameter / 2
                        });

                skSolve(cableSketch);

                opSweep(context, id + "cableSweep", {
                            "profiles" : qSketchRegion(id + "cableSketch"),
                            "path" : qUnion(cablePath.edges)
                        });

                setProperty(context, {
                            "entities" : qCreatedBy(id + "cableSweep", EntityType.FACE),
                            "propertyType" : PropertyType.APPEARANCE,
                            "value" : getColor(wire.cable.color)
                        });

                setAttribute(context, {
                            "entities" : qNonCapEntity(id + "cableSweep", EntityType.FACE),
                            "name" : "diameter",
                            "attribute" : wire.cable.diameter
                        });

                setAttribute(context, {
                            "entities" : qCreatedBy(id + "cableSweep", EntityType.BODY),
                            "name" : "flatten",
                            "attribute" : true
                        });
            }
            catch
            {
                errorWarning(context, id, "Unable to create cable geometry. Check for possible minimum bend radius violation.");
            }
        } // end of show cable

        if (wire.from.refId != false)
            for (var refId in wire.from.refId)
                refs = append(refs, qCreatedBy(refId, EntityType.BODY));

        if (wire.to.refId != false)
            for (var refId in wire.to.refId)
                refs = append(refs, qCreatedBy(refId, EntityType.BODY));

        connectors = append(connectors, qModifiableEntityFilter(qUnion(refs)));

        try silent
        {
            const compositeId = id + "composite";

            // group all wire features together to make a cable
            opCreateCompositePart(context, compositeId, {
                        "bodies" : qUnion(wireBodies, solidBodies),
                        "closed" : true
                    });

            const harness = makeHarness(context, id, definition, wires, qUnion(connectors), cableName);

            setData(context, [{ (cableName) : { "wireIds" : wireIds, "diameter" : cableDiameter, "color" : definition.cableColor, "bend" : cableBend, "error" : cableBendError } }], "cables");

            harnessIds = harness.wireIds;
            harnessId = harness.harnessId;
        }
        catch
        {
            errorWarning(context, id, "Unable to create composite cable.");
        }
    }

    if (definition.show)
        opDeleteBodies(context, id + "deleteSketch", {
                    "entities" : qSketchFilter(qCreatedBy(id, EntityType.BODY), SketchObject.YES)
                });

    if (harnessIds != [])
        setData(context, [{ "wireIds" : harnessIds, "harnessId" : harnessId }], "harnesses");
}

export function getWireTags(wireData is map, wireId is string, override is map)
{
    return mergeMaps(
        {
                "wireId" : wireId,
                "section" : "wire",
                "bend" : wireData[wireId].bend,
                "color" : wireData[wireId].color,
                "diameter" : wireData[wireId].diameter,
                "gauge" : wireData[wireId].gauge,
                "area" : wireData[wireId].area,
                "from" : {
                    "ref" : wireData[wireId].from.ref,
                    "pin" : wireData[wireId].from.pin,
                    "strip" : wireData[wireId].from.strip,
                    "stub" : wireData[wireId].from.stub,
                    "splice" : wireData[wireId].from.splice
                },
                "to" : {
                    "ref" : wireData[wireId].to.ref,
                    "pin" : wireData[wireId].to.pin,
                    "strip" : wireData[wireId].to.strip,
                    "stub" : wireData[wireId].to.stub,
                    "splice" : wireData[wireId].to.splice
                }
            }, override);
}

export function getWireIds(context is Context, definition is map)
{
    var cableName = "";
    var wires = [];

    for (var i, wire in definition.wires)
    {
        if (wire.feedback != " " && wire.feedback != "(manual)") // wire has error
            continue;

        wires = append(wires, wire.id);

        if (definition.cable && definition.cableName == "")
        {
            if (i > 0)
                cableName ~= "/";

            cableName ~= wire.id;
        }
    }

    if (definition.cable && definition.cableName != "")
        cableName = definition.cableName;

    return { "cable" : cableName == "" ? undefined : cableName, "wires" : wires };
}

export function upgradeStrip(definition is map)
{
    if (definition.version >= V_195)
        return definition;

    if (definition.stripTo == StripTo.DEPRECATED)
        return definition;

    if (definition.stripTo == StripTo.NONE)
    {
        definition.stripFirst = StripFirst.STRIP;
        definition.stripSecond = StripSecond.STRIP;
    }
    else if (definition.stripTo == StripTo.CABLE)
    {
        definition.stripFirst = StripFirst.CABLE;
        definition.stripSecond = StripSecond.CABLE;
    }
    else if (definition.stripTo == StripTo.CABLE_FIRST)
    {
        definition.stripFirst = StripFirst.STRIP;
        definition.stripSecond = StripSecond.CABLE;
    }
    else if (definition.stripTo == StripTo.CABLE_LAST)
    {
        definition.stripFirst = StripFirst.CABLE;
        definition.stripSecond = StripSecond.STRIP;
    }
    else if (definition.stripTo == StripTo.FIRST)
    {
        definition.stripFirst = StripFirst.CLIP;
        definition.stripSecond = StripSecond.STRIP;
    }
    else if (definition.stripTo == StripTo.LAST)
    {
        definition.stripFirst = StripFirst.STRIP;
        definition.stripSecond = StripSecond.CLIP;
    }
    else if (definition.stripTo == StripTo.BOTH)
    {
        definition.stripFirst = StripFirst.CLIP;
        definition.stripSecond = StripSecond.CLIP;
    }

    return definition;
}

export function upgrade(version is number, input is map)
{
    if (version >= V_195)
        return input;

    var output = {};

    for (var key in keys(input))
    {
        const splitKey = match(key, "(w\\d*)?(c\\d*[se]?)(.*)").captures;

        if (splitKey[1] == "" || input[splitKey[2]] == undefined)
            output[splitKey[2]] = input[key];
    }

    return output;
}

export function upgradeBundles(definition is map)
{
    if (definition.version >= V_204)
        return definition;

    // upgrade pre-178 offsets
    for (var key in keys(definition.bundleOffset))
    {
        const splitKey = match(key, "w(\\d*)(c\\d*)(b\\d*)(.*)").captures;

        const index = stringToNumber(splitKey[1]);

        if (index >= size(definition.wires))
        {
            definition.bundleOffset[key] = undefined;
            continue;
        }

        if (definition.wires[index].bundleOffsets[splitKey[3]] == undefined)
        {
            definition.wires[stringToNumber(splitKey[1])].bundleOffsets[splitKey[3]] = definition.bundleOffset[key];
            definition.bundleOffset[key] = undefined;
        }
    }

    // upgrade pre-204 offsets
    for (var i, wire in definition.wires)
    {
        if (wire.bundleOffsets.b0 != undefined)
        {
            definition.wires[i].bundleOffsets["c" ~ i ~ "bs"] = wire.bundleOffsets.b0;
            definition.wires[i].bundleOffsets.b0 = undefined;
            definition.wires[i].bundleOffsets["c" ~ i ~ "be"] = wire.bundleOffsets.b1;
            definition.wires[i].bundleOffsets.b1 = undefined;
        }
    }

    return definition;
}

