export function getWireGeometry(data is map, wireLengthUnits)
{
    const gaugeFactor = data.manual == undefined ? 1 : 1000;

    const wireGaugeList = {
            "0000" : 11.68,
            "4/0" : 11.68,
            "000" : 10.40,
            "3/0" : 10.40,
            "00" : 9.27,
            "2/0" : 9.27,
            "0" : 8.25,
            "1" : 7.35,
            "2" : 6.54,
            "3" : 5.83,
            "4" : 5.19,
            "5" : 4.62,
            "6" : 4.12,
            "7" : 3.66,
            "8" : 3.26,
            "9" : 2.91,
            "10" : 2.59,
            "11" : 2.30,
            "12" : 2.05,
            "13" : 1.83,
            "14" : 1.63,
            "15" : 1.45,
            "16" : 1.29,
            "17" : 1.15,
            "18" : 1.02,
            "19" : 0.91,
            "20" : 0.81,
            "21" : 0.72,
            "22" : 0.64,
            "23" : 0.57,
            "24" : 0.51,
            "25" : 0.45,
            "26" : 0.40,
            "27" : 0.36,
            "28" : 0.32,
            "29" : 0.29,
            "30" : 0.25,
            "31" : 0.23,
            "32" : 0.20,
            "33" : 0.18,
            "34" : 0.16,
            "35" : 0.14,
            "36" : 0.13,
            "37" : 0.11,
            "38" : 0.10,
            "39" : 0.09,
            "40" : 0.08,
        };

    var wireGauge = data["wireGauge"];

    if (wireGauge is undefined || wireGauge == "")
        wireGauge = 0;
    else if (wireGauge is number)
        wireGauge = wireGaugeList[toString(wireGauge)] / gaugeFactor;
    else if (wireGauge is string)
        wireGauge = wireGaugeList[toString(trim(wireGauge, "\""))] / gaugeFactor;

    var outerDiameter = 0;
    var coreDiameter = 0;
    const wireDiameter = (data["wireDiameter"] is number) ? data["wireDiameter"] : 0;
    const wireArea = (data["wireArea"] is number) ? sqrt(data["wireArea"] / PI) * 2 : 0;
    const wireInsulation = (data["wireInsulation"] is number) ? data["wireInsulation"] : 0;
    const wireType = wireGauge != 0 ? "wireGauge" : (wireArea != 0 ? "wireArea" : undefined);
    const wireSize = wireGauge != 0 ? data["wireGauge"] : (wireArea != 0 ? data["wireArea"] : undefined);

    if (wireDiameter > 0)
    {
        outerDiameter = wireDiameter;

        if (wireGauge > 0 && wireGauge < outerDiameter)
            coreDiameter = wireGauge;

        else if (wireArea > 0 && wireArea < outerDiameter)
            coreDiameter = wireArea;

        else if (wireInsulation > 0 && wireInsulation < outerDiameter / 2)
            coreDiameter = outerDiameter - 2 * wireInsulation;

        else
            coreDiameter = 0.65 * outerDiameter; // for approximate visual purposes only
    }
    else if (wireGauge > 0)
    {
        coreDiameter = wireGauge;
        outerDiameter = coreDiameter;

        if (wireInsulation > 0)
            outerDiameter = coreDiameter + 2 * wireInsulation;
    }
    else if (wireArea > 0)
    {
        coreDiameter = wireArea;
        outerDiameter = coreDiameter;

        if (wireInsulation > 0)
            outerDiameter = coreDiameter + 2 * wireInsulation;
    }

    return { "outerDiameter" : outerDiameter * wireLengthUnits,
            "coreDiameter" : coreDiameter * wireLengthUnits,
            (wireType) : wireSize };
}

function getHarnessData(context is Context, definition is map, wires is Query)
{
    var harness = {};

    for (var wire in evaluateQuery(context, wires))
    {
        const wireData = getAttribute(context, {
                    "entity" : wire,
                    "name" : "wireSegment"
                });

        if (wireData != undefined && wireData.harness != undefined)
        {
            const parentId = wireData.harness.parentId;
            harness[parentId] = harness[parentId] != undefined ? harness[parentId] : { "diameter" : wireData.harness.diameter };

            var edges = harness[parentId].edges == undefined ? [] : harness[parentId].edges;
            edges = append(edges, qCreatedBy(lastModifyingOperationId(context, wire), EntityType.EDGE));

            if (edges != [])
            {
                harness[parentId].edges = edges;
                harness[parentId].diameter = wireData.harness.diameter;
                harness[parentId].parentId = lastModifyingOperationId(context, qCompositePartsContaining(qHasAttributeWithValueMatching("wireSegment", { "wireId" : parentId, })))[0];
            }
        }
    }

    return harness;
}

