export enum ConnectorAction
{
    annotation { "Name" : "Insert" }
    INSERT,
    annotation { "Name" : "Define" }
    DEFINE
}

export enum ConnectorType
{
    annotation { "Name" : "Connector" }
    CONNECTOR,
    annotation { "Name" : "Terminal" }
    TERMINAL,
    annotation { "Name" : "Splice" }
    SPLICE
}

export enum UpDirection
{
    annotation { "Name" : "+X axis" }
    X,
    annotation { "Name" : "-X axis" }
    X_MINUS,
    annotation { "Name" : "+Y axis" }
    Y,
    annotation { "Name" : "-Y axis" }
    Y_MINUS,
    annotation { "Name" : "+Z axis" }
    Z,
    annotation { "Name" : "-Z axis" }
    Z_MINUS
