 */
export const TORUS_MAJOR_RADIUS_BOUNDS =
{
    (meter)      : [1e-5, 0.025*2, 500],
    (centimeter) : 2.5*2,
    (millimeter) : 25.0*2,
    (inch)       : 1.0*2,
    (foot)       : 0.1*2,
    (yard)       : 0.025*2
} as LengthBoundSpec;

