FeatureScript 1576;
import(path : "onshape/std/geometry.fs", version : "1576.0");

annotation { "Feature Type Name" : "Composite everything" }
export const myFeature = defineFeature(function(context is Context, id is Id, definition is map)
    precondition
    {
        annotation { "Name" : "Parts to exclude", "Filter" : EntityType.BODY}
        definition.partsToExclude is Query;
        
        annotation { "Name" : "Closed" }
        definition.closed is boolean;
        
        
    }
    {
        var everything = qEverything(EntityType.BODY) -> qBodyType([BodyType.SOLID, BodyType.SHEET]) -> qSketchFilter(SketchObject.NO) -> qConstructionFilter(ConstructionObject.NO);
        var composites = qConsumed(everything, Consumed.YES);
        var subtraction = qUnion([definition.partsToExclude, composites]);
        var bodies = everything -> qSubtraction(subtraction);        
        
        opCreateCompositePart(context, id + "compositePart1", {
                "bodies" : bodies,
                "closed" : definition.closed
        });
        
    });
