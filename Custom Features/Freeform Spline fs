// finds the curve param of each point on the fit spline
export function getPointParametersOnSpline(context is Context, points is array, spline is Query) returns array
{
    var pointParameters = [];
    for (var point in points)
    {
        var parameter = evDistance(context, {
                    "side0" : point,
                    "side1" : spline
                }).sides[1].parameter;

        pointParameters = append(pointParameters, parameter);
    }
    return pointParameters;
}

// getting midpoints between the existing points to help create point manip locations for insert mode. If it's an interpolated spline, the midpoints are on the spline. If not, the midpoints are in-line between each set of points
export function getIntermediatePoints(context is Context, points is array, isOnSpline is boolean, spline is Query) returns array
{

    var intermediatePoints = [];

    if (isOnSpline) // finding the midpoint between two points on the spline via averaged parameter values
    {
        var pointParameters = getPointParametersOnSpline(context, points, spline);

        for (var i = 0; i < size(points) - 1; i += 1)
        {
            var averageParameter = (pointParameters[i] + pointParameters[i + 1]) / 2;
            var intermediatePoint = evEdgeTangentLine(context, {
                        "edge" : spline,
                        "parameter" : averageParameter
                    }).origin;
            intermediatePoints = append(intermediatePoints, intermediatePoint);
        }
    }
    else // finding the midpoint between two points in world space via averaged coordinate values
    {
        for (var i = 0; i < size(points) - 1; i += 1)
        {
            var A = points[i];
            var B = points[i + 1];
            var intermediatePoint = vector((A[0] + B[0]) / 2, (A[1] + B[1]) / 2, (A[2] + B[2]) / 2);
            intermediatePoints = append(intermediatePoints, intermediatePoint);
        }
    }

    return intermediatePoints;
}

// inserts a new item into an array at a specified index, increasing the array size by one.
export function insertIntoArray(theArray is array, itemToInsert, index is number) returns array
{
    var newArray = makeArray(size(theArray) + 1);
    var offset = 0;
    for (var i = 0; i < size(newArray); i += 1)
    {
        if (i == index)
        {
            newArray[i] = itemToInsert;
            offset = 1;
        }
        else
        {
            newArray[i] = theArray[i - offset];
        }
    }
    return newArray;
}

export function deleteArrayItems(theArray is array, indicesToDelete is array) returns array
{
    var newArray = [];
    for (var i = 0; i < size(theArray); i += 1)
    {
        if (isIn(i, indicesToDelete))
        {
            continue;
        }
        else
        {
            newArray = append(newArray, theArray[i]);
        }
    }
    return newArray;
}

