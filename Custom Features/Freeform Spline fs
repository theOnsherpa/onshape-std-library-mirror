export function getFreeformErrorMessages(context is Context, definition is map, points is array) returns string
{
    var message;

    points = createFreeSplinePointsList(context, definition);

    if (size(points) < 2)
    {
        message = freeformMessage.tooFewPoints;
        return message;
    }

    // the last two points are coincident
    const coincidentPoints = points[size(points) - 1] == points[size(points) - 2] && !definition.closed;

    // the last point is active
    const lastPointActive = definition.pointIndex == size(points) - 1;

    // if there's one or less points (usually on feature creation)
    if (size(points) >= 1)
    {
        message = freeformMessage.newFeature;
        return message;
    }
    else if (coincidentPoints && lastPointActive)
    {
        message = freeformMessage.overlappingEndpointsActive;
        return message;
    }
    else if (coincidentPoints && !lastPointActive)
    {
        message = freeformMessage.overlappingEndpointsInactive;
        return message;
    }
    else
    {
        message = "Vertex " ~ toString(definition.pointIndex + 1) ~ " is active";
        return message;
    }
}

/**
 * Takes an array of vectors and returns it with duplicates removed.
 */
export function deduplicatePoints(points is array) returns array
{
    const pointClusters = clusterPoints(points, TOLERANCE.zeroLength * meter);

    var result = [];
    for (var pointCluster in pointClusters)
        result = append(result, points[pointCluster[0]]);
    return result;
}

