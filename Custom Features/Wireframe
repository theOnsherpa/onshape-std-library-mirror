annotation { "Feature Type Name" : "Wireframe", "Icon" : icon::BLOB_DATA }
export const wires = defineFeature(function(context is Context, id is Id, definition is map)
    precondition
    {
        
        annotation { "Name" : "Body to Wire", "Filter" : EntityType.BODY, }
        definition.body is Query;
        
        annotation { "Name" : "Width" }
        isLength(definition.width, LENGTH_BOUNDS);
        
        annotation { "Name" : "Add depth" }
        definition.addDepth is boolean;
        
        if (definition.addDepth)
        {
        annotation { "Name" : "Depth" }
        isLength(definition.depth, LENGTH_BOUNDS);
        }
        
    
    }
    {
    

// thicken faces inward 

    // variables
    var width = definition.width;
    var depth;
    if (definition.addDepth)
    {
        depth = definition.depth;
    }
    else
    {
        depth = width;
    }
    var faceQuery is Query = qOwnedByBody(definition.body, EntityType.FACE);
    var faces is array = evaluateQuery(context, faceQuery);

    for (var i = 0; i < size(faces); i += 1)
    {
        var face is Query = faces[i];
    
         // thicken operation
    
        opThicken(context, id + "thickens" + i + "thicken1", {
                "entities" : face,
                "thickness1" : 0.5*millimeter,
                "thickness2" : depth + 0.5*millimeter
            
        });
    
        // Move non cap faces of thickened bodies
    
            // variables
        
            var allFaces is Query = qCreatedBy(id + "thickens" + i +"thicken1", EntityType.FACE);
            
            var capFaces is Query = qUnion([
                qCapEntity(id + "thickens" + i +"thicken1", true),
                qCapEntity(id + "thickens" + i +"thicken1", false)]
                );
                
            var nonCapFaces = qSubtraction(allFaces , capFaces);
            

            
        // move operation
        
        opOffsetFace(context, id + "thickens" + i + "offsetFace1", {
                "moveFaces" : nonCapFaces,
                "offsetDistance" : -width
        });
                
    }
       
// hollow main part
    
    opShell(context, id + "shell1", {
                "entities" : definition.body,
                "thickness" : -depth
        });
    
// subtract extrudes from main part
    
    var subtractions is Query = qCreatedBy(id + "thickens", EntityType.BODY);

    opBoolean(context, id + "boolean1", {
            "tools" : subtractions,
            "targets" : definition.body,
            "operationType" : BooleanOperationType.SUBTRACTION
    });
        
        
});
